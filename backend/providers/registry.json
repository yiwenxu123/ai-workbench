  },
  "runway": {
    "status_endpoint_template": "{endpoint}/{task_id}",
    "status_fields": ["task_status", "status"],
    "status_map": {
      "submitted": "pending",
      "queued": "pending",
      "running": "processing",
      "processing": "processing",
      "succeeded": "succeed",
      "succeed": "succeed",
      "completed": "succeed",
      "failed": "failed",
      "error": "failed"
    },
    "default_status": "pending",
    "result_url_fields": ["result_url", "video_url", "url", "output_url"],
    "nested_output_fields": ["video_url", "url", "result_url"],
    "artifact_fields": ["artifacts"],
    "artifact_url_keys": ["url", "video_url", "src"],
    "require_http_prefix": true,
