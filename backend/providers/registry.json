    "default_status": "pending",
    "result_url_fields": ["result_url", "video_url", "url"],
    "nested_output_fields": [],
    "artifact_fields": [],
    "artifact_url_keys": [],
    "require_http_prefix": false,
    "last_verified": "2026-06-12",
    "notes": "可灵官方接口: 提交返回 task_id, 状态查询 GET {base}/{task_id}"
  },
  "jimeng": {
    "status_endpoint_template": "{endpoint}/{task_id}",
    "status_fields": ["task_status", "status"],
    "status_map": {
      "submitted": "pending",
      "running": "processing",
      "processing": "processing",
      "succeed": "succeed",
      "suc": "succeed",
      "failed": "failed",
      "fail": "failed"
