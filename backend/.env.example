# ── AI绘图工作台 后端环境配置 ──────────────────────────────────────────
# 复制此文件为 .env 并填入真实密钥
#
# 所有配置项均为可选，不配置则前端需要用户自行输入密钥。
# 配置后，后端将自动使用这些密钥，前端对应配置入口自动隐藏。

# ── 通用图像生成 ──────────────────────────────────────────────────────
API_KEY=
API_ENDPOINT=

# ── 视频生成 ───────────────────────────────────────────────────────────
# 可灵 Kling
KLING_API_KEY=
KLING_API_ENDPOINT=https://api.klingai.com/v1/videos/generations

# 即梦 Jimeng（字节跳动）
JIMENG_API_KEY=
JIMENG_API_ENDPOINT=

# Runway Gen-3
RUNWAY_API_KEY=
RUNWAY_API_ENDPOINT=

# ── 图片编辑 ───────────────────────────────────────────────────────────
# 阿里云通义万相
ALIYUN_API_KEY=
ALIYUN_API_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/image2image/image-edit

# ── 服务器配置（可选） ─────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
