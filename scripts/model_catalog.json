{
  "_version": 1,
  "_note": "视频生产模型目录（v5.1）。与 DSH 自身的对话模型配置相互独立：这里只管『脚本→成片』的生产模型（TTS/生图/视频）。加模型优先在网关后台配渠道，这里只登记条目；引擎启动时把条目动态合并进 provider 注册表，新增可用模型通常无需改 Python。价格单位：TTS=元/万字符，image/video=元/张(片段)。tag 仅用于面板分组。",
  "gateways": {
    "stepfun": {
      "base_url": "https://api.stepfun.com/v1",
      "secret_file": "stepfun.env",
      "key_env": "STEPFUN_API_KEY",
      "_note": "阶跃星辰，OpenAI 兼容 /audio/speech 与 /images/generations"
    },
    "newapi": {
      "base_url": "",
      "secret_file": "newapi.env",
      "key_env": "NEWAPI_API_KEY",
      "_note": "自托管 new-api/one-api 网关（OpenAI 兼容）。base_url 形如 http://host:3000/v1；在后台挂好百炼图像/TTS 等渠道后填这里，一处密钥聚合多家。"
    },
    "siliconflow": {
      "base_url": "https://api.siliconflow.cn/v1",
      "secret_file": "siliconflow.env",
      "key_env": "SILICONFLOW_API_KEY",
      "_note": "硅基流动（OpenAI 兼容）。生图尺寸 width×height，竖版 720x1280。"
    },
    "ark-plan": {
      "base_url": "https://ark.cn-beijing.volces.com/api/plan/v3",
      "secret_file": "ark.env",
      "key_env": "ARK_API_KEY",
